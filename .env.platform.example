# Next.js
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=/api/backend
API_HOST=0.0.0.0
API_PORT=8000

# FastAPI / MySQL
DATABASE_URL=mysql://sparkflow:sparkflow@127.0.0.1:3307/sparkflow
APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
ENVIRONMENT=development
# Startup performs an idempotent schema self-check and version migration.
AUTO_CREATE_TABLES=false
AUTO_MIGRATE=true
ENCRYPTION_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Epay V1 or V2; never commit real values.
EPAY_URL=https://pay.example.com
EPAY_VERSION=V1
EPAY_PID=
EPAY_KEY=
EPAY_PRIVATE_KEY=
EPAY_PUBLIC_KEY=
